{
  "name": "puppy-desktop",
  "version": "0.1.0",
  "description": "A Claude-desktop-style app for Code Puppy: chat + code workspaces over ACP.",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "package:mac": "bash scripts/make-app.sh",
    "postinstall": "node --env-file-if-exists=.env.local scripts/ensure-electron.cjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.11.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "~5.8.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "^4.0.0"
  }
}
